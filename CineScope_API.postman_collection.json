{
  "info": {
    "name": "CineScope AI Backend API",
    "description": "Complete API collection for CineScope AI backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Forgot Password (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/forgot",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "forgot"]
            }
          }
        },
        {
          "name": "Verify OTP and Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/verify-otp",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "Get Trending Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/movies/trending?type=popular&page=1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "movies", "trending"],
              "query": [
                {
                  "key": "type",
                  "value": "popular"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Search Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/movies/search?q=inception&page=1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "movies", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "inception"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Movie Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/movies/550",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "movies", "550"]
            }
          }
        },
        {
          "name": "Get Genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/movies/genres/list",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "movies", "genres", "list"]
            }
          }
        }
      ]
    },
    {
      "name": "AI Features",
      "item": [
        {
          "name": "Summarize Movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"description\": \"A thief who steals corporate secrets through the use of dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O.\",\n  \"year\": \"2010\",\n  \"genres\": [\"Action\", \"Sci-Fi\", \"Thriller\"]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/ai/summarize",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "ai", "summarize"]
            }
          }
        },
        {
          "name": "Explain Movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"question\": \"What does the ending mean?\",\n  \"context\": \"The spinning top scene\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/ai/explain",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "ai", "explain"]
            }
          }
        },
        {
          "name": "Get Recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favoriteMovies\": [\"Inception\", \"Interstellar\", \"The Matrix\"],\n  \"genres\": [\"Sci-Fi\", \"Thriller\"],\n  \"mood\": \"mind-bending\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/ai/recommend",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "ai", "recommend"]
            }
          }
        }
      ]
    },
