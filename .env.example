# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas for production)
MONGO_URI=mongodb://localhost:27017/cinescope
# For production use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/cinescope

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Trakt.tv API (Movie & TV Database)
# Get your API key from: https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
TRAKT_BASE_URL=https://api.trakt.tv

# OMDb API (Movie Details & Posters)
# Get your API key from: http://www.omdbapi.com/apikey.aspx
# Multiple API keys for rotation (comma-separated)
OMDB_API_KEYS=key1,key2,key3,key4
OMDB_BASE_URL=http://www.omdbapi.com

# Watchmode API (Streaming Availability)
# Get your API key from: https://api.watchmode.com/
WATCHMODE_KEY=your_watchmode_api_key_here
WATCHMODE_BASE_URL=https://api.watchmode.com/v1

# Default country for streaming availability (ISO 3166-1 alpha-2 code)
DEFAULT_COUNTRY_CODE=IN

# Google Gemini API (AI Features)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (Gmail App Password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
